# Python caches and bytecode
__pycache__/
*.py[cod]
*.pyo

# Build and packaging
build/
dist/
*.egg-info/
.eggs/

# Test and coverage artifacts
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# Virtual environments
.venv/
.venv-*/
venv/
env/
ENV/

# Local environment and secrets
.env
.env.*
!.env.example
.secrets.scan

# ML artifacts and local experiment stores
mlruns/
mlartifacts/
app/artifacts/*.pkl
app/artifacts/*.joblib
app/artifacts/*.h5
app/artifacts/*.pth
app/models/*.pkl
app/models/*.joblib
!app/artifacts/.gitkeep

# Data directories: keep structure, ignore local content
data/raw/*
data/processed/*
data/interim/*
data/external/*
!data/**/.gitkeep

# Notebooks
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/

# IDE/editor
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Local archive folders from cleanup scripts
archive_*/
